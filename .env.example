# Local configuration for chora-user-event-stream.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENV=local
PORT=8080
CHORA_SOURCE_PROJECT=chora-local

# SSE heartbeat interval in seconds (default 15).
CHORA_REALTIME_KEEPALIVE_SECONDS=15

# Redis backplane (per-GCID pub/sub + single-use ticket jti).
# Unset CHORA_REDIS_ADDR → streaming disabled (health-only).
CHORA_REDIS_ADDR=redis:6379
CHORA_REDIS_PASSWORD=
CHORA_REDIS_CA_CERT=

# Event bus — NATS JetStream (chora-common/eventbus), consumed by the fan-in
# tier. Unset NATS_URL → fan-in disabled (health-only).
NATS_URL=nats://nats:4222

# HMAC stream ticket signer (HS256, ≥32 bytes) — shared with chora-gateway,
# which mints the short-lived stream tickets. Unset disables ticket validation.
CHORA_REALTIME_TICKET_SIGNER_SECRET=change-me-to-a-32-byte-minimum-signing-key

# Optional env-backed secret indirection: when a *_SECRET_ID is set the value
# is resolved from the environment (SECRET_<NORMALISED_ID> / <NORMALISED_ID> /
# <ID>) instead of the literal env above. An unresolvable configured secret is
# a fail-loud boot error.
# CHORA_REDIS_PASSWORD_SECRET_ID=chora-realtime-redis-password
# CHORA_REDIS_CA_CERT_SECRET_ID=chora-realtime-redis-ca-cert
# CHORA_REALTIME_TICKET_SIGNER_SECRET_ID=chora-realtime-ticket-signer

# CORS allowlist for the SSE stream (comma-separated, scheme-qualified).
# Unset → the built-in chora-web origin set.
CHORA_CORS_ALLOWED_ORIGINS=

# Tracing — OTLP/gRPC endpoint. Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
